body {
    font-family: Arial, sans-serif;
    background-color: #f0f4f8;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}

.game-container {
    background-color: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    text-align: center;
    max-width: 400px;
    width: 100%;
}

h1 {
    color: #333;
    font-size: 24px;
    margin-bottom: 20px;
}

.scoreboard {
    display: flex;
    justify-content: space-around;
    margin-bottom: 30px;
}

.score-box {
    background-color: #e2e8f0;
    padding: 10px 20px;
    border-radius: 8px;
}

.score-box p {
    margin: 0 0 5px 0;
    font-weight: bold;
    color: #4a5568;
}

.score-box span {
    font-size: 24px;
    color: #2d3748;
}

.choices {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 30px;
}

.choice-btn {
    background-color: #3182ce;
    color: white;
    border: none;
    padding: 12px 15px;
    border-radius: 6px;
    font-size: 16px;
    cursor: pointer;
    flex: 1;
    transition: background-color 0.3s;
}

.choice-btn:hover {
    background-color: #2b6cb0;
}

.messages {
    font-size: 18px;
    font-weight: bold;
    color: #2d3748;
    min-height: 25px;
}
